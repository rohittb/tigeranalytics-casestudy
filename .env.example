# Environment configuration for Retail Pricing Management POC

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retail_pricing
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/retail_pricing

# Redis / Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
UPLOAD_DIR=/app/data/uploads

# Guardrails & Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_DATA_ROWS=50000
MAX_COLUMNS=50
DB_BATCH_SIZE=1000

# CORS & Application
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Local Host Ports (avoids local machine port collisions)
API_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5433
REDIS_PORT=6380

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080
